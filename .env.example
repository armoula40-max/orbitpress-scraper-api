PORT=8080
# مفتاح طويل عشوائي (32+ حرفاً) — أقصر من ذلك ترفض الخدمة الطلبات بـ 500
ORBITPRESS_API_KEY=replace-with-a-long-random-secret
BROWSER_HEADLESS=true
MAX_CONCURRENT_JOBS=2
# مهلة كل مهمة سحب بالمللي ثانية (افتراضي 90 ثانية)
JOB_TIMEOUT_MS=90000
# حد الطلبات لكل عنوان IP خلال نافذة زمنية
RATE_LIMIT_MAX=60
RATE_LIMIT_WINDOW_MS=60000
# اجعلها true مؤقتاً لتشخيص الأخطاء — لا تفعّلها في الإنتاج
EXPOSE_ERROR_DETAILS=false
USE_PERSISTENT_SESSIONS=true
SESSION_DIR=/sessions
# عدد الـ pins التي تُفتح صفحاتها لاستخراج تفاصيل meta (0 لتعطيل الإثراء)
PINTEREST_ENRICH_LIMIT=5
# Optional: Apify token for provider=apify Facebook scraping
APIFY_API_TOKEN=replace-with-apify-token
